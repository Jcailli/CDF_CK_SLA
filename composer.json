{
    "name": "app/coupe-n1-app",
    "description": "Mini projet Symfony - Coupe de France N1, N2, N3",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.11",
        "symfony/console": "^7.0",
        "symfony/dotenv": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/runtime": "^7.0",
        "symfony/twig-bundle": "^7.0",
        "symfony/yaml": "^7.0",
        "dompdf/dompdf": "^3.1"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "php bin/console cache:clear"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"]
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
