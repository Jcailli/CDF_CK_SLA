<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Classement {{ circuit }} {{ categorie }} {{ annee }}</title>
    <style>
        @page { margin: 12mm 10mm; }
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: {{ pdf_font_size|default(7)|number_format(2, '.', '') }}px;
            color: #222;
            margin: 0;
        }
        h1 { margin: 0 0 5px 0; font-size: {{ (pdf_font_size|default(7) + 3)|number_format(2, '.', '') }}px; white-space: nowrap; }
        .meta { margin: 0 0 8px 0; color: #666; font-size: {{ pdf_font_size|default(7)|number_format(2, '.', '') }}px; white-space: nowrap; }
        /* Largeurs naturelles par colonne, pas de renvoi à la ligne dans les cellules */
        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        th, td {
            border: 1px solid #bbb;
            padding: {{ pdf_cell_padding_v|default(2) }}px {{ pdf_cell_padding_h|default(4) }}px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }
        th { background: #f1f1f1; font-weight: 700; text-align: left; }
        td.r, th.r { text-align: right; }
        .col-cat { width: 8%; }
        .col-rang { width: 6%; }
        .col-bateau { width: 17%; white-space: normal; word-break: break-word; }
        .col-club { width: 17%; white-space: normal; word-break: break-word; }
        .col-points { width: auto; }
        .slot-best { background: #14532d !important; color: #ecfdf5 !important; font-weight: 700; }
        .row-n3-qualifie td { background: #fef3c7; }
        .row-n3-qualifie td.slot-best { background: #14532d !important; color: #ecfdf5 !important; border: 1px solid #f59e0b; }
        /* Colonnes courtes : contenu serré */
        th:first-child, td:first-child { padding-left: 4px; padding-right: 4px; }
    </style>
</head>
<body>
    <h1>Classement Coupe de France {{ circuit }} - {{ categorie }}</h1>
    <p class="meta">Saison {{ annee }} — PDF généré depuis export CSV intermédiaire.</p>

    <table>
        <thead>
            <tr>
                {% for header in csv_headers %}
                    {% set thClass = '' %}
                    {% if header == 'Rang' %}
                        {% set thClass = 'col-rang' %}
                    {% elseif header == 'Bateau' %}
                        {% set thClass = 'col-bateau' %}
                    {% elseif header == 'Cat' %}
                        {% set thClass = 'col-cat' %}
                    {% elseif header == 'Club' %}
                        {% set thClass = 'col-club' %}
                    {% else %}
                        {% set thClass = 'col-points r' %}
                    {% endif %}
                    <th class="{{ thClass }}">{{ header }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in csv_rows %}
                {% set meta = csv_row_meta[loop.index0]|default({'qualifie_finale_n3': false, 'highlight_headers': [], 'highlight_finale': false}) %}
                <tr class="{{ meta.qualifie_finale_n3 ? 'row-n3-qualifie' : '' }}">
                    {% for header in csv_headers %}
                        {% set tdClass = '' %}
                        {% if header == 'Rang' %}
                            {% set tdClass = 'col-rang' %}
                        {% elseif header == 'Bateau' %}
                            {% set tdClass = 'col-bateau' %}
                        {% elseif header == 'Cat' %}
                            {% set tdClass = 'col-cat' %}
                        {% elseif header == 'Club' %}
                            {% set tdClass = 'col-club' %}
                        {% else %}
                            {% set tdClass = 'col-points r' %}
                        {% endif %}
                        {% if header in meta.highlight_headers or (header == 'Finale' and meta.highlight_finale) %}
                            {% set tdClass = tdClass ~ ' slot-best' %}
                        {% endif %}
                        <td class="{{ tdClass }}">{{ row[header]|default('')|e }}</td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>
